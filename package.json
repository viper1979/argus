{
  "name": "argus",
  "productName": "Argus",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-Desktop-App, die parallele Coding-Agent-Sessions in eigenen Git-Worktrees startet und überwacht.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
